# LLM Configuration (OpenRouter - Space Bunny Alpha)

# OpenRouter API Key (get yours at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Base URL (OpenRouter)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Name (stealth/space-bunny-alpha)
OPENROUTER_MODEL=stealth/space-bunny-alpha

# OpenRouter Application Attribution Headers
OPENROUTER_SITE_URL=https://github.com/infraimpact
OPENROUTER_APP_NAME=InfraImpact Intelligence Platform

# Operational Settings
LLM_TIMEOUT=35.0
LLM_TEMPERATURE=0.0

# Set to "true" to force local offline mock mode without making HTTP requests
BIG_PICKLE_MOCK=false
